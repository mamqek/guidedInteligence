@@ -0,0 +1,85 @@
+from dataclasses import replace
+import unittest
+
+from services.retrieval.workspace.pipeline.execution_flow.discovery_observations import (
+    DiscoveryObservation, DiscoveryProvenance, RetrievedSourceView, SourceHandle,
+)
+from services.retrieval.workspace.pipeline.execution_flow.hidden_anchor_source import (
+    prepare_hidden_anchor_source, request_code_names,
+)
+from services.retrieval.workspace.pipeline.execution_flow.initial_owner_comparison import _compact_source_view
+from services.retrieval.workspace.pipeline.execution_flow.owner_comparison_source import prepare_owner_sources
+
+
+class HiddenAnchorSourceTests(unittest.TestCase):
+    def observation(self, text, terms=('Symbol',)):
+        return DiscoveryObservation('id', SourceHandle('test.js', 10, 10+len(text.splitlines())-1), text,
+            (DiscoveryProvenance('dense', 'q', matched_terms=terms),),
+            source_views=(RetrievedSourceView('test.js', 10, 10+len(text.splitlines())-1, text),))
+
+    def repair(self, observation, request='Symbol conversion fails', **kwargs):
+        return prepare_hidden_anchor_source(observation, names=request_code_names(request),
+                                            compact=_compact_source_view, **kwargs)
+
+    def test_only_code_shaped_request_names(self):
+        self.assertEqual(request_code_names('value type Symbol getValue snake_name Symbol'),
+                         ('Symbol', 'getValue', 'snake_name'))
+
+    def test_hidden_symbol_restored_without_losing_old_view(self):
+        text="expect(errors.count()).toBe(0)\nexpect(other.count()).toBe(0)\n" + '\n'*4 + \
+             "it('symbol', () => {\n  makeInstance(Symbol('foo'), Symbol)\n  expect(errors.count()).toBe(0)\n  makeInstance({}, Symbol)\n  expect('Expected Symbol').toHaveBeenWarned()\n})"
+        original = self.observation(text)
+        repaired = self.repair(original)
+        self.assertEqual(repaired.reason, 'hidden_request_name_restored')
+        self.assertTrue(repaired.views[0].text.startswith(_compact_source_view(text)))
+        self.assertIn("makeInstance(Symbol('foo'), Symbol)", repaired.views[0].text)
+        self.assertIn('additional source lines', repaired.views[0].text)
+        self.assertLessEqual(sum(len(v.text) for v in repaired.views), 1024)
+        prepared = prepare_owner_sources((original,), workspace_root='.', source_ast=None,
+            mode='consistent', max_chars=1024, user_request='Symbol conversion fails').observations[0]
+        self.assertEqual(prepared.handle, original.handle)
+        self.assertEqual(prepared.provenance, original.provenance)
+        self.assertEqual(prepared.source_views, original.source_views)
+        self.assertEqual(prepared.comparison_source_views, repaired.views)
+
+    def test_generic_missing_terms_do_not_expand(self):
+        original = self.observation('expect(x.count()).toBe(0)\nexpect(y.count()).toBe(0)\nconst value = type;', ('value', 'type'))
+        self.assertEqual(self.repair(original, 'value type').reason, 'no_hidden_request_name')
+
+    def test_capitalized_prose_without_code_use_does_not_expand(self):
+        original = self.observation('expect(x.count()).toBe(0)\nexpect(y.count()).toBe(0)\n// The value Cannot convert', ('The', 'Cannot'))
+        self.assertFalse(self.repair(original, 'The value Cannot convert').views)
+
+    def test_visible_name_anywhere_in_candidate_does_not_expand(self):
+        original = self.observation('Symbol(value)\nother()')
+        extra = RetrievedSourceView('test.js', 50, 51, 'expect(x.count()).toBe(0)\nSymbol(y)')
+        self.assertFalse(self.repair(replace(original, source_views=(*original.source_views, extra))).views)
+
+    def test_request_source_and_retrieval_match_all_required(self):
+        text='expect(x.count()).toBe(0)\nexpect(y.count()).toBe(0)\nSymbol(value)'
+        self.assertFalse(self.repair(self.observation(text, ('value',))).views)
+        self.assertFalse(self.repair(self.observation(text), 'other issue').views)
+        self.assertFalse(self.repair(self.observation(text.replace('Symbol', 'symbol'))).views)
+
+    def test_complete_owner_never_changed(self):
+        o = self.observation('expect(x.count()).toBe(0)\nSymbol(value)')
+        o = replace(o, handle=replace(o.handle, node_id='function:x', full_line_start=10, full_line_end=11))
+        self.assertEqual(self.repair(o).reason, 'resolved_owner_unchanged')
+
+    def test_shared_budget_and_one_window(self):
+        text='expect(x.count()).toBe(0)\nexpect(y.count()).toBe(0)\nSymbol(value)'
+        original = self.observation(text)
+        original = replace(original, source_views=tuple(replace(original.source_views[0], line_start=10+i*5,
+                           line_end=12+i*5) for i in range(8)))
+        repaired = self.repair(original)
+        self.assertEqual(sum(v.text.count('[additional source lines') for v in repaired.views), 1)
+        self.assertLessEqual(sum(len(v.text) for v in repaired.views), 1024)
+        self.assertFalse(self.repair(original, max_chars=10).views)
+
+    def test_overlong_witness_not_silently_clipped(self):
+        o = self.observation('expect(x.count()).toBe(0)\nexpect(y.count()).toBe(0)\n' + 'a'*600 + ' Symbol(value)')
+        self.assertEqual(self.repair(o).reason, 'anchor_context_does_not_fit')
+
+
+if __name__ == '__main__':
+    unittest.main()

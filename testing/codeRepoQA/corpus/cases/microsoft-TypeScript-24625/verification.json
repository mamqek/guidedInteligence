      "Ok, I ended up changing my code around `reportWatchStatusChanged` to the following: ```typescript const formatDiagnostic = (diag: ts.Diagnostic) => { return ts.formatDiagnostic(diag, formatHost).trimRight() } const ignoreDiagnostic = (diag: ts.Diagnostic) => { return [6031, 6032].indexOf(diag.code) !== -1 } const reportDiagnostic = (diag: ts.Diagnostic) => { if (!ignoreDiagnostic(diag)) { console.error(formatDiagnostic(diag)) } } let firstCompilationDone = false const isCompilationDone = (diag: ts.Diagnostic) => { return diag.code === 6194 && diag.messageText === 'Found 0 errors. Watching for ",

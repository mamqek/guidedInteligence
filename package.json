{
  "name": "guided-inteligence",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "retrieval:server": "python -m services.retrieval.server",
    "web:dev": "vite --config ui/vite.config.ts",
    "web:build": "vite build --config ui/vite.config.ts",
    "web:preview": "vite preview --config ui/vite.config.ts",
    "obsidian:index": "set OBSIDIAN_VAULT_PATH=docs/obsidian&& obsidian-hybrid-search --db docs/obsidian/.obsidian-hybrid-search.db reindex",
    "obsidian:status": "set OBSIDIAN_VAULT_PATH=docs/obsidian&& obsidian-hybrid-search --db docs/obsidian/.obsidian-hybrid-search.db status",
    "obsidian:search": "set OBSIDIAN_VAULT_PATH=docs/obsidian&& obsidian-hybrid-search --db docs/obsidian/.obsidian-hybrid-search.db search"
  },
  "dependencies": {
    "obsidian-hybrid-search": "0.13.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}

{
  "name": "guided-inteligence",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "retrieval:server": ".venv\\Scripts\\python.exe -m services.retrieval.server",
    "config:web:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force .guided-intelligence | Out-Null; Copy-Item configs/web-ui/workspace.json .guided-intelligence/config.json -Force\"",
    "config:web:codex": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force .guided-intelligence | Out-Null; Copy-Item configs/web-ui/codex.json .guided-intelligence/config.json -Force\"",
    "config:web:codex:efficient": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force .guided-intelligence | Out-Null; Copy-Item configs/web-ui/codex-efficient.json .guided-intelligence/config.json -Force\"",
    "config:web:codex:responsibility-complete": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force .guided-intelligence | Out-Null; Copy-Item configs/web-ui/codex-responsibility-complete.json .guided-intelligence/config.json -Force\"",
    "coderepoqa:evaluate:workspace": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-case --run-config configs/testing/workspace.json",
    "coderepoqa:evaluate:codex": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-case --run-config configs/testing/codex.json",
    "coderepoqa:evaluate:codex:efficient": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-case --run-config configs/testing/codex-efficient.json",
    "coderepoqa:evaluate:codex:responsibility-complete": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-case --run-config configs/testing/codex-responsibility-complete.json",
    "coderepoqa:batch:workspace": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-batch --run-config configs/testing/workspace-smoke.json",
    "coderepoqa:batch:codex": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-batch --run-config configs/testing/codex-smoke.json",
    "coderepoqa:batch:codex:efficient": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-batch --run-config configs/testing/codex-efficient.json",
    "coderepoqa:batch:codex:responsibility-complete": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-batch --run-config configs/testing/codex-responsibility-complete.json",
    "coderepoqa:batch:compare": ".venv\\Scripts\\python.exe testing/codeRepoQA/run_case.py evaluate-compare-batch --workspace-run-config configs/testing/workspace.json --codex-run-config configs/testing/codex.json",
    "web:dev": "vite --config ui/vite.config.ts",
    "web:build": "vite build --config ui/vite.config.ts",
    "web:preview": "vite preview --config ui/vite.config.ts",
    "obsidian:index": "set OBSIDIAN_VAULT_PATH=docs/obsidian&& obsidian-hybrid-search --db docs/obsidian/.obsidian-hybrid-search.db reindex",
    "obsidian:status": "set OBSIDIAN_VAULT_PATH=docs/obsidian&& obsidian-hybrid-search --db docs/obsidian/.obsidian-hybrid-search.db status",
    "obsidian:search": "set OBSIDIAN_VAULT_PATH=docs/obsidian&& obsidian-hybrid-search --db docs/obsidian/.obsidian-hybrid-search.db search"
  },
  "dependencies": {
    "obsidian-hybrid-search": "0.13.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}

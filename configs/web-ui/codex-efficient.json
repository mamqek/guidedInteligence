{
  "enabled_source_categories": [
    "source_code",
    "documentation",
    "issue_tracker",
    "pull_request",
    "local_notes",
    "notebooklm"
  ],
  "enabled_sources": [
    "source_code",
    "repo_docs",
    "github-issues",
    "github-prs",
    "notion-pages",
    "shortcut-stories",
    "local_notes",
    "notebooklm"
  ],
  "indexing": {
    "enable_indexing": false,
    "exclude_paths": [
      ".git",
      ".guided-intelligence",
      ".codegraph",
      ".venv",
      "__pycache__",
      "node_modules",
      "dist",
      "build",
      ".cache",
      "coverage"
    ]
  },
  "retrieval": {
    "mode": "codex",
    "codex_command": [
      "codex"
    ],
    "codex_model": "gpt-5.4-mini",
    "workspace_model": "",
    "codex_prompt_profile": "efficient",
    "codex_timeout_seconds": 900
  },
  "generation": {
    "provider": "api",
    "api_model": "",
    "codex_model": "gpt-5.4-mini",
    "max_tokens": 800,
    "timeout_seconds": 30
  },
  "connections": {
    "api_llm": {
      "api_style": "openai_chat_completions",
      "endpoint_url": "",
      "api_key": "",
      "model": "",
      "temperature": 0,
      "max_tokens": 800,
      "timeout_seconds": 30
    },
    "codex": {
      "command": [
        "codex"
      ],
      "ignore_user_config": true,
      "timeout_seconds": 30
    }
  },
  "connected_context": {
    "enabled": true,
    "max_sources": 8,
    "max_calls": 8,
    "max_candidates_per_source": 5,
    "max_candidates_total": 20,
    "max_candidate_chars": 2400,
    "max_candidate_chars_total": 24000,
    "max_selected_context": 4,
    "max_selected_evidence": 2,
    "timeout_seconds": 45
  },
  "ui": {
    "default_prompt": "Explain where abstract class parsing and validation happen."
  }
}

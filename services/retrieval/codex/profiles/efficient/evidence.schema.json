{
  "type": "object",
  "properties": {
    "prompt_summary": {
      "type": "string"
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line_start": {
            "type": "integer"
          },
          "line_end": {
            "type": "integer"
          },
          "claim_supported": {
            "type": "string"
          },
          "why_relevant": {
            "type": "string"
          },
          "coverage_area": {
            "type": "string"
          },
          "artifact_kind": {
            "type": "string",
            "enum": [
              "source_authoring_file",
              "built_or_distribution_artifact",
              "generated_or_baseline_artifact",
              "test_or_fixture",
              "unknown"
            ]
          }
        },
        "required": [
          "file",
          "line_start",
          "line_end",
          "claim_supported",
          "why_relevant",
          "coverage_area",
          "artifact_kind"
        ],
        "additionalProperties": false
      }
    },
    "answer_blocking_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "prompt_summary",
    "relevant_files",
    "evidence",
    "answer_blocking_uncertainties",
    "scope_notes"
  ],
  "additionalProperties": false
}

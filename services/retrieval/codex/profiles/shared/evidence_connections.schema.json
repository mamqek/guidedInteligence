{
  "evidence_item": {
    "properties": {
      "evidence_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required": [
      "evidence_id"
    ]
  },
  "response": {
    "properties": {
      "evidence_connections": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {
            "source_evidence_id": {
              "type": "string"
            },
            "target_evidence_id": {
              "type": "string"
            },
            "relationship_kind": {
              "type": "string",
              "enum": [
                "dependency",
                "control_flow",
                "data_flow",
                "configuration",
                "validation",
                "rendering",
                "other"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "grounding": {
              "type": "string",
              "enum": [
                "direct",
                "inferred"
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          "required": [
            "source_evidence_id",
            "target_evidence_id",
            "relationship_kind",
            "label",
            "description",
            "grounding",
            "confidence"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "evidence_connections"
    ]
  }
}

# Retrieval LLM configuration
#
# Allowed RETRIEVAL_LLM_API_STYLE values:
# - openai_chat_completions: OpenAI-compatible Chat Completions HTTP API.
#
# Retrieval runs require all of the variables below. Missing required values
# cause startup/config loading to fail.
#
# RETRIEVAL_LLM_ENDPOINT_URL must be the full request URL. The code does not
# append path suffixes such as /chat/completions for you.

RETRIEVAL_LLM_API_STYLE=openai_chat_completions
RETRIEVAL_LLM_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
RETRIEVAL_LLM_MODEL=gpt-4.1-mini
RETRIEVAL_LLM_API_KEY=
RETRIEVAL_LLM_TEMPERATURE=0
RETRIEVAL_LLM_MAX_TOKENS=800
RETRIEVAL_LLM_TIMEOUT_SECONDS=30
RETRIEVAL_LLM_CONTINUITY_ENABLED=false
RETRIEVAL_ENABLE_INDEXING=true

# Workspace retrieval mode is stored per selected repository in
# .guided-intelligence/config.json under retrieval.mode:
# - workspace: use the local CGC/BM25/Qdrant retrieval pipeline.
# - codex: call `codex exec` in the selected workspace and use its structured
#   evidence output as the retrieval result.
# Codex mode defaults to model gpt-5.4-mini and requires the Codex CLI to be
# authenticated separately.

# Retrieval embedding configuration
#
# Allowed RETRIEVAL_EMBEDDING_API_STYLE values:
# - openai_embeddings: OpenAI-compatible Embeddings HTTP API.
#
# Embedding runs require all of the variables below.

RETRIEVAL_EMBEDDING_API_STYLE=openai_embeddings
RETRIEVAL_EMBEDDING_ENDPOINT_URL=https://api.openai.com/v1/embeddings
RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-large
RETRIEVAL_EMBEDDING_API_KEY=
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=30
RETRIEVAL_EMBEDDING_BATCH_SIZE=16
RETRIEVAL_EMBEDDING_CONCURRENCY=4

# Local Qdrant runtime configuration
RETRIEVAL_QDRANT_URL=http://localhost:6333
RETRIEVAL_QDRANT_COLLECTION=guided_intelligence_retrieval_role_scoped
RETRIEVAL_QDRANT_TIMEOUT_SECONDS=30

# Optional public HTTPS base URL used for OAuth callbacks through ngrok,
# Cloudflare Tunnel, or a hosted callback domain.
# Example: https://example.ngrok-free.dev
OAUTH_REDIRECT_BASE_URL=

# Optional local UI URL used by the OAuth success page return button.
OAUTH_RETURN_BASE_URL=http://127.0.0.1:5173

# Hosted GitHub MCP browser connect.
#
# Create one GitHub OAuth app for the tool and set its Authorization callback URL to:
# http://127.0.0.1:8790/connections/provider-auth/callback
#
# Users do not enter these values in the UI. They only click Connect GitHub.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=repo read:org

# Hosted Notion MCP browser connect.
#
# Create one public Notion OAuth integration for the tool and set its redirect URI to:
# http://127.0.0.1:8790/connections/provider-auth/callback
#
# Users do not enter these values in the UI. They only click Connect Notion.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Hosted Shortcut connector.
#
# Shortcut's public REST API uses token-based auth. Create an API token at:
# https://app.shortcut.com/settings/account/api-tokens
SHORTCUT_API_TOKEN=

# Example: standard OpenAI-compatible endpoint
# RETRIEVAL_LLM_API_STYLE=openai_chat_completions
# RETRIEVAL_LLM_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
# RETRIEVAL_LLM_MODEL=gpt-4.1-mini
# RETRIEVAL_LLM_API_KEY=sk-...

# Example: alternate OpenAI-compatible proxy endpoint
# RETRIEVAL_LLM_API_STYLE=openai_chat_completions
# RETRIEVAL_LLM_ENDPOINT_URL=https://llmproxy.uva.nl/chat/completions
# RETRIEVAL_LLM_MODEL=<proxy-supported-model>
# RETRIEVAL_LLM_API_KEY=sk-...

# Example: OpenAI-compatible embeddings endpoint
# RETRIEVAL_EMBEDDING_API_STYLE=openai_embeddings
# RETRIEVAL_EMBEDDING_ENDPOINT_URL=https://llmproxy.uva.nl/embeddings
# RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-large
# RETRIEVAL_EMBEDDING_API_KEY=sk-...
